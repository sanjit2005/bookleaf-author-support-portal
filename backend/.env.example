# Replace placeholders locally; never commit .env
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
SAMPLE_DATA_PATH="C:/path/to/original-sample.json"
# Generate >=32 random bytes as hex using the documented local command.
JWT_SECRET=<GENERATE_32_RANDOM_BYTES_AS_HEX>
PORT=5000
NODE_ENV=development
# Optional: leave empty for fully functional manual ticket handling.
GEMINI_API_KEY=
# Gemini Developer API, free-tier eligible subject to account/region/quota.
# Confirm model availability before an explicit replacement.
GEMINI_MODEL=gemini-3.5-flash-lite

# Exact comma-separated origins, without paths/trailing slashes. HTTPS required in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional in every mode. Leave empty on Render to keep Express proxy trust false.
# Set only independently verified ingress IPs/CIDRs; never use * or a hop count.
# Without proxy trust, production login uses account-target limits plus bounded concurrency.
TRUSTED_PROXY_CIDRS=
